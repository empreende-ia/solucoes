# ============================================================
# Dispara — variáveis de ambiente
# Copie para .env.local e preencha os valores.
# ============================================================

# --- Supabase (obrigatório) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Relógio pg_cron (obrigatório — filas de disparo, agendamentos, waits de fluxo) ---
# Segredo que autentica as chamadas do pg_cron a /api/cron/tick.
# Deve ser IGUAL ao secret 'cron_secret' gravado no Vault do Supabase.
CRON_SECRET=

# --- Autenticação ---
# Senha de login do dashboard
MASTER_PASSWORD=
# Chave da REST API (Authorization: Bearer / X-API-Key)
DISPARA_API_KEY=
# Chave dos endpoints administrativos (/api/vercel/*, /api/debug/*) — opcional
DISPARA_ADMIN_KEY=
# Segredo de assinatura das sessões (opcional, >= 32 caracteres). Sem ele, a chave é
# derivada de SUPABASE_SECRET_KEY. Trocar este valor, a SUPABASE_SECRET_KEY ou a
# MASTER_PASSWORD derruba todas as sessões do dashboard.
SESSION_SECRET=

# --- WhatsApp Cloud API (opcional — fallback se não configurado via UI) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Assinatura dos webhooks da Meta (recomendado) ---
# App Secret do App da Meta. Também pode ser salvo pela UI (Configurações); a env tem precedência.
# Com App Secret, /api/webhook e /api/flows/endpoint exigem X-Hub-Signature-256 válida.
# Sem App Secret, aceitam requisições não assinadas (aviso no log e em Diagnósticos da Meta).
META_APP_SECRET=
# 'true' = rejeita requisições não assinadas mesmo sem App Secret (fail-closed total).
META_WEBHOOK_REQUIRE_SIGNATURE=

# --- IA (opcional) ---
GEMINI_API_KEY=
MEM0_API_KEY=
