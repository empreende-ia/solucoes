# Local-only maintenance scripts
# Importante: não ignore o diretório inteiro (scripts/) se você quiser permitir
# exceções pontuais. Por isso usamos scripts/* e liberamos explicitamente o arquivo.
scripts/*
!scripts/meta-audit.mjs
!scripts/check-migrations.mjs

