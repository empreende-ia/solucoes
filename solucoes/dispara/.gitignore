.DS_Store
*.local

# Supabase CLI temp files
supabase/.temp/

# Vercel
.vercel

# TypeScript
*.tsbuildinfo


# Testing
test-results/
playwright-report/
coverage/
.nyc_output/

# Testes (suites pesadas mantidas apenas localmente)
# Usa tests/* (não tests/) para que a negação de tests/helpers/ funcione:
# git não reinclui subpastas de um diretório inteiramente excluído.
tests/*
# Helpers de teste são necessários no CI
!tests/helpers/
!tests/helpers/**

